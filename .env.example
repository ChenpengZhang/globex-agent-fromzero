LLM_BASE_URL=<OpenAI Compatible API URL>
LLM_API_KEY=<Your API Key>
LLM_MODEL=<Model Name>

# Embedding defaults to the LLM-compatible gateway when omitted.
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# When embedding and LLM aren't from the same provider.
# EMBEDDING_BASE_URL=<Embedding API URL>
# EMBEDDING_API_KEY=<Embedding API Key>

# Empty means qdrant-client local mode.
QDRANT_URL=
CATEGORY_KB_COLLECTION=globex_category_kb

# Empty means reranking is disabled.
RERANKER_BASE_URL=
RERANKER_MODEL=

DATA_DIR=.data
# Empty uses <DATA_DIR>/globex.db.
DATABASE_URL=

# Empty disables all Redis-backed capabilities.
REDIS_URL=

# Enable Redis Stream task delivery.
# This requires REDIS_URL and a separately running worker.
QUEUE_ENABLED=0

# Maximum number of Agent tasks processed concurrently by one worker.
WORKER_CONCURRENCY=1

# Move a repeatedly failing task to the dead-letter stream after this many deliveries.
QUEUE_MAX_DELIVERIES=3

# Route long conversations to the lower-priority Stream.
QUEUE_PRIORITY_ENABLED=1
QUEUE_LARGE_REQUEST_TURNS=30

# Reuse safe first-turn replies for sufficiently similar queries.
# This only takes effect when REDIS_URL is configured.
SEMANTIC_CACHE_ENABLED=1

# Cosine similarity required for a semantic cache hit.
SEMANTIC_CACHE_THRESHOLD=0.95

# Enable embedding-based relevance ranking for buyer preferences.
# Disabled by default to avoid extra embedding API calls.
PREFERENCE_RELEVANCE_ENABLED=0

# Maximum number of like preferences injected into one request.
# Dislike constraints are always retained.
PREFERENCE_TOP_K=5

# Inject buyer preferences into SearchAgent dispatches.
PREFERENCE_SUBAGENT_INJECT=1

PRODUCT_VECTOR_COLLECTION=globex_product_vectors
