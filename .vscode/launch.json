{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: Interactive shopping",
      "type": "debugpy",
      "request": "launch",
      "module": "app.presentation.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Pytest: Place order success",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "-vv",
        "tests/test_place_order.py::test_place_order_deducts_inventory_and_saves_confirmed_order"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Place order rollback",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "-vv",
        "tests/test_place_order.py::test_place_order_restores_prior_deductions_after_later_failure"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Full order Agent flow",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "-vv",
        "tests/test_order_agent_integration.py::test_agent_places_queries_and_cancels_order_in_one_session"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
